msgstr "Periksa setiap kolom email di peramban saat pengunjung mengetik"

#: includes/Settings.php:399
msgid "Widget key"
msgstr "Kunci widget"

#: includes/Settings.php:441
msgid "Testing the connection…"
msgstr "Menguji koneksi…"

#: includes/Settings.php:442
msgid "The connection test could not be completed."
msgstr "Uji koneksi tidak dapat diselesaikan."

#: includes/Settings.php:538
#: includes/Settings.php:565
msgid "You are not allowed to do that."
msgstr "Anda tidak diizinkan melakukan tindakan tersebut."

#: includes/Settings.php:544
msgid "The API client is not available."
msgstr "Klien API tidak tersedia."

#: includes/Settings.php:584
msgid "Create an API key in your CekEmail dashboard and paste it here."
msgstr "Buat kunci API di dasbor CekEmail Anda lalu tempelkan di sini."

#: includes/Settings.php:593
msgid "Decide what happens when an address cannot be confirmed. Invalid addresses are always blocked."
msgstr "Tentukan apa yang terjadi saat sebuah alamat tidak dapat dipastikan. Alamat yang tidak valid selalu diblokir."

#: includes/Settings.php:602
msgid "Integrations only run while an API key is saved."
msgstr "Integrasi hanya berjalan selama kunci API tersimpan."

#: includes/Settings.php:611
msgid "The widget gives visitors feedback before they submit a form. It never exposes your API key."
msgstr "Widget memberi umpan balik kepada pengunjung sebelum mereka mengirim formulir. Widget tidak pernah menampilkan kunci API Anda."

#: includes/Settings.php:612
msgid "The script is bundled with the plugin, is only loaded on the front end, and attaches itself to every email field on the page, whichever plugin or theme rendered it."
msgstr "Skrip disertakan di dalam plugin, hanya dimuat di sisi depan situs, dan menempel pada setiap kolom email di halaman, apa pun plugin atau tema yang menampilkannya."

#: includes/Settings.php:629
msgid "A key is saved. Leave blank to keep the current key."
msgstr "Sebuah kunci telah tersimpan. Biarkan kosong untuk mempertahankan kunci saat ini."

#: includes/Settings.php:631
msgid "No key saved yet. Leave blank to keep the current key."
msgstr "Belum ada kunci yang tersimpan. Biarkan kosong untuk mempertahankan kunci saat ini."

#: includes/Settings.php:649
msgid "Only change this if you use a self-hosted CekEmail instance."
msgstr "Ubah hanya jika Anda menggunakan instans CekEmail yang Anda hosting sendiri."

#: includes/Settings.php:678
msgid "Test connection"
msgstr "Uji koneksi"

#: includes/Settings.php:683
msgid "Saves nothing and uses no credits. Save your settings first."
msgstr "Tidak menyimpan apa pun dan tidak menggunakan kredit. Simpan pengaturan Anda terlebih dahulu."

#: includes/Settings.php:720
msgid "Allow the submission"
msgstr "Izinkan pengiriman"

#: includes/Settings.php:722
msgid "Block the submission"
msgstr "Blokir pengiriman"

#: includes/Settings.php:664
#: includes/Settings.php:741
