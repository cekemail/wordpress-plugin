msgstr "https://cekemail.com/"

#. Description of the plugin
#: cekemail-email-validation.php
msgid "Validates email addresses submitted through WordPress forms with the CekEmail API, blocking invalid, undeliverable and disposable addresses before they reach your database."
msgstr "Memverifikasi alamat email yang dikirim melalui formulir WordPress dengan API CekEmail, memblokir alamat yang tidak valid, tidak dapat dikirimi email, dan sekali pakai sebelum masuk ke basis data Anda."

#. Author of the plugin
#: cekemail-email-validation.php
#: includes/Settings.php:437
msgid "CekEmail"
msgstr "CekEmail"

#: includes/Admin_Notices.php:97
msgid "CekEmail:"
msgstr "CekEmail:"

#: includes/Admin_Notices.php:100
msgid "Open CekEmail settings"
msgstr "Buka pengaturan CekEmail"

#: includes/Admin_Notices.php:114
msgid "Your account has run out of credits, so email addresses are no longer being verified."
msgstr "Kredit akun Anda telah habis, sehingga alamat email tidak lagi diverifikasi."

#: includes/Admin_Notices.php:116
msgid "Your API key is not allowed to verify email addresses from this site. Check its scopes and IP allowlist."
msgstr "Kunci API Anda tidak diizinkan memverifikasi alamat email dari situs ini. Periksa cakupan dan daftar IP yang diizinkan."

#: includes/Admin_Notices.php:119
msgid "Your API key was rejected. Email addresses are no longer being verified."
msgstr "Kunci API Anda ditolak. Alamat email tidak lagi diverifikasi."

#: includes/Api_Client.php:90
msgid "Add your API key and save the settings before testing the connection."
msgstr "Tambahkan kunci API Anda dan simpan pengaturan sebelum menguji koneksi."

#: includes/Api_Client.php:101
msgid "Connection successful. Your API key is valid."
msgstr "Koneksi berhasil. Kunci API Anda valid."

#: includes/Api_Client.php:285
msgid "The API key was rejected. Check that you copied the whole key and that it has not been revoked."
msgstr "Kunci API ditolak. Pastikan Anda menyalin seluruh kunci dan kunci tersebut belum dicabut."

#: includes/Api_Client.php:287
msgid "Your CekEmail account has run out of credits."
msgstr "Kredit akun CekEmail Anda telah habis."

#: includes/Api_Client.php:289
msgid "This API key is not allowed to verify email addresses from this site. Check its scopes and IP allowlist."
msgstr "Kunci API ini tidak diizinkan memverifikasi alamat email dari situs ini. Periksa cakupan dan daftar IP yang diizinkan."

#: includes/Api_Client.php:291
msgid "Too many requests were sent to the API. Please try again in a minute."
msgstr "Terlalu banyak permintaan dikirim ke API. Silakan coba lagi dalam satu menit."

#: includes/Api_Client.php:293
msgid "Could not reach the CekEmail API. Check the API URL and your server connectivity."
msgstr "Tidak dapat menghubungi API CekEmail. Periksa URL API dan koneksi server Anda."

#: includes/Api_Client.php:295
msgid "The API returned an unexpected response."
msgstr "API mengembalikan respons yang tidak terduga."

