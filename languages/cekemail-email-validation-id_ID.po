msgstr "Bersihkan log"

#: includes/Settings.php:884
msgid "The API URL must be a full http or https address. The default was restored."
msgstr "URL API harus berupa alamat http atau https yang lengkap. Nilai bawaan telah dipulihkan."

#: includes/Validator.php:104
msgid "We could not verify your email address right now. Please try again in a few minutes."
msgstr "Kami tidak dapat memverifikasi alamat email Anda saat ini. Silakan coba lagi dalam beberapa menit."

#. translators: %s: suggested email address.
#: includes/Validator.php:164
#, php-format
msgid "This email address cannot receive mail. Did you mean %s?"
msgstr "Alamat email ini tidak dapat menerima email. Apakah maksud Anda %s?"

#: includes/Validator.php:167
msgid "This email address cannot receive mail. Please check it for typos."
msgstr "Alamat email ini tidak dapat menerima email. Silakan periksa kembali apakah ada salah ketik."

#. translators: %s: suggested email address.
#: includes/Validator.php:172
#, php-format
msgid "Disposable email addresses are not accepted. Did you mean %s?"
msgstr "Alamat email sekali pakai tidak diterima. Apakah maksud Anda %s?"

#: includes/Validator.php:175
msgid "Disposable email addresses are not accepted. Please use a permanent address."
msgstr "Alamat email sekali pakai tidak diterima. Silakan gunakan alamat permanen."

#. translators: %s: suggested email address.
#: includes/Validator.php:180
#, php-format
msgid "We could not confirm that this email address can receive mail. Did you mean %s?"
msgstr "Kami tidak dapat memastikan bahwa alamat email ini dapat menerima email. Apakah maksud Anda %s?"

#: includes/Validator.php:183
msgid "We could not confirm that this email address can receive mail. Please use a different address."
msgstr "Kami tidak dapat memastikan bahwa alamat email ini dapat menerima email. Silakan gunakan alamat lain."

#. translators: %s: suggested email address.
#: includes/Validator.php:188
#, php-format
msgid "We could not verify this email address. Did you mean %s?"
msgstr "Kami tidak dapat memverifikasi alamat email ini. Apakah maksud Anda %s?"

#: includes/Validator.php:191
msgid "We could not verify this email address. Please use a different address."
msgstr "Kami tidak dapat memverifikasi alamat email ini. Silakan gunakan alamat lain."

#: includes/Settings.php:274
msgid "Request timeout"
msgstr "Batas waktu permintaan"

#: includes/Settings.php:667
msgid "How long to wait for the CekEmail API before applying the 'API errors' policy. Slow mail servers can take up to 30 seconds on the first check of an address; later checks are cached."
msgstr "Berapa lama menunggu API CekEmail sebelum kebijakan 'Kesalahan API' diterapkan. Server email yang lambat dapat memerlukan waktu hingga 30 detik pada pemeriksaan pertama sebuah alamat; pemeriksaan berikutnya diambil dari cache."

